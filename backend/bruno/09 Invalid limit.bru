meta {
  name: Reject limit over 100
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/products?limit=101
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("invalid limit returns BAD_REQUEST", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(400);
    expect(body.success).to.equal(false);
    expect(body.error.code).to.equal("BAD_REQUEST");
    expect(body.error.message).to.be.a("string").and.not.empty;
  });
}
