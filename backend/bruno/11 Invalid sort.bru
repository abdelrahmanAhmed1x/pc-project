meta {
  name: Reject unknown sort
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/products?sort=newest
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("unknown sort returns BAD_REQUEST", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(400);
    expect(body.success).to.equal(false);
    expect(body.error.code).to.equal("BAD_REQUEST");
  });
}
