meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("health returns an OK envelope", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("ok");
  });
}
