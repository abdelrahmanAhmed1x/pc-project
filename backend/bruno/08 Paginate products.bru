meta {
  name: Paginate products
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/products?page=2&limit=2
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8082
}

tests {
  test("page two reports consistent metadata", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.success).to.equal(true);
    expect(body.data.items).to.be.an("array");
    expect(body.data.items.length).to.be.at.most(2);
    expect(body.data.meta.page).to.equal(2);
    expect(body.data.meta.limit).to.equal(2);
    expect(body.data.meta.total_pages).to.equal(Math.ceil(body.data.meta.total_items / 2));
  });
}
