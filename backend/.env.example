DATABASE_URL=postgres://user:password@localhost:5432/pcparts?sslmode=disable
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=replace-me

# Use the opaque ID returned by the local model server's /v1/models endpoint.
AI_BASE_URL=http://localhost:9000/v1
AI_MODEL=served-model-name
AI_API_KEY=
AI_TIMEOUT=180s
# memory loses sessions on restart; postgres uses ADK's official database service.
AI_SESSION_STORAGE=memory
